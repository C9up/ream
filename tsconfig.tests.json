{
  // The tests, typechecked in their own program.
  //
  // `tsconfig.json` compiles `src` alone, so no test file was ever read by
  // `tsc`. 366 errors were waiting behind that, nine of them in the framework's
  // own public types.
  //
  // One file is still out, and it is not a "later": TypeScript hard-codes
  // `any[]` in the mixin-base rule (TS2545) — `never[]` will not do — and this
  // project bans `any`, so the two cannot both be honoured there.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "tests/unit/helpers-compose.test.ts"]
}
