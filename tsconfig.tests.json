{
  // The tests, typechecked in their own program.
  //
  // `tsconfig.json` compiles `src` alone, so no test file was ever read by
  // `tsc`. 366 errors were waiting behind that, four of them in the framework's
  // own public types — see the commit that widened this.
  //
  // Nine files are still excluded, and named one by one rather than as a
  // directory: an exclusion that names what it excludes shrinks, a blanket one
  // does not. Each is a stated cause, not a "later".
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests"],
  "exclude": [
    "node_modules",

    // TypeScript requires a mixin's base to be `new (...args: any[]) => …`
    // (TS2545) — the rule is hard-coded in the compiler and `never[]` will not
    // do. This project bans `any`, so the two cannot both be honoured here.
    "tests/unit/helpers-compose.test.ts",

    // `declare module '../../src/types/authenticators.js'` — a relative
    // specifier in a module augmentation, which is what the test is ABOUT
    // (a host augmenting `Authenticators`). Making it compile means giving the
    // package a path the augmentation can name.
    "tests/unit/auth-use-typing.test.ts",

    // A plain `.js` helper beside the tests with no declarations, so importing
    // it is an implicit `any`. Needs the helper typed, not the test changed.
    "tests/unit/events/helix-helpers.test.ts",

    // Hand-written fakes of a context / a channel subscriber / a middleware
    // that have drifted from the shapes they stand for. The same repair as the
    // ones already done, one file at a time.
    "tests/unit/brisk-render.test.ts",
    "tests/unit/health.test.ts",
    "tests/unit/openapi-provider.test.ts",
    "tests/unit/framework-commands.test.ts",
    "tests/unit/events/emitter.test.ts",
    "tests/unit/macroable.test.ts"
  ]
}
