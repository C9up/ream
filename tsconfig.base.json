{
  // Shared by tsconfig.app / tsconfig.package / tsconfig.client. Emit options
  // (declaration, sourceMap, outDir) belong to the leaf that knows what it is
  // building — a base that decides them makes every leaf fight it.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist"]
}
